// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "opentelemetry-operator-demo",
    "build": {
        "dockerfile": "Dockerfile",
        // Update 'VARIANT' to pick an Debian version: bullseye, buster
        // Use bullseye on local arm64/Apple Silicon.
        "args": {
            "VARIANT": "trixie",
            "USERNAME": "vscode"
        }
    },
    "mounts": [
        "source=${localWorkspaceFolder}/.devcontainer,target=/commandhistory,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "WORKSPACE_FOLDER": "${containerWorkspaceFolder}"
    },
    "customizations": {
        "vscode": {
            // Set *default* container specific settings.json values on container create.
            "settings": {              
				"dev.containers.copyGitConfig": true,
				"dev.containers.dockerCredentialHelper": true,
				"dev.containers.githubCLILoginWithToken": true,	
                "terminal.integrated.enableImages": true,
                "terminal.integrated.fontLigatures.enabled": true,
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash"
                    },
                    "zsh": {
                        "path": "/bin/zsh"
                    }
                }
            },
            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "github.vscode-github-actions",
                "github.vscode-pull-request-github",
                "davidAnson.vscode-markdownlint",
                "ms-azuretools.vscode-containers",
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "redhat.vscode-yaml"
            ]
        }
    },
    // See: https://containers.dev/features
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "moby": "false",
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest"
        },
        "ghcr.io/dhoeric/features/k9s:1": {
            "version": "latest"
        },
        "ghcr.io/mpriscella/features/kind:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "version": "latest",
            "minikube": "none"
        },
        "ghcr.io/guiyomh/features/just:0": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/node:2": {
            "version": "lts"
        },
        "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {
            "version": "latest"
        }
    },
    "forwardPorts": [
        "localhost:3000",
        "localhost:8089",
        "localhost:16686",
        "localhost:4000",
        "localhost:8082"
    ],
    "portsAttributes": {
        "3000": {
            "label": "Grafana",
            "protocol": "http",
            "onAutoForward": "silent"
        },
        "8089": {
            "label": "Load Generator",
            "protocol": "http",
            "onAutoForward": "silent"
        },
        "16686": {
            "label": "Jaeger",
            "protocol": "http",
            "onAutoForward": "silent"
        },
        "4000": {
            "label": "Flagd Configurator",
            "protocol": "http",
            "onAutoForward": "silent"
        },
        "8082": {
            "label": "ArgoCD",
            "protocol": "https",
            "onAutoForward": "silent"
        }
    },
    "postCreateCommand": ".devcontainer/postcreate.sh"
}